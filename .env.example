APP_DEBUG=false
BASE_URL=

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# HMAC pepper for token digests (player tokens, game private keys).
# Generate once per environment: php -r "echo bin2hex(random_bytes(32));"
TOKEN_PEPPER=

# Required when cron scripts are invoked over HTTP (Hostinger web cron).
CRON_TOKEN=

# Developer login-code mail (M1). Hostinger SMTP or transactional provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
