APP_DEBUG=false
BASE_URL=

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# HMAC pepper for token digests (player tokens, game private keys).
# Generate once per environment: php -r "echo bin2hex(random_bytes(32));"
TOKEN_PEPPER=

# Required when cron scripts are invoked over HTTP (Hostinger web cron).
CRON_TOKEN=

# Developer login-code mail — sent via send_mail() (src/mailer.php).
# From envelope used by both transports; use an address on your hosted domain.
EMAIL_FROM=
# Authenticated SMTP sender — only for hosts that allow outbound SMTP.
# WARNING: Hostinger SHARED hosting blocks outbound 465/587 — leave SMTP_HOST
# empty there so send_mail() falls back to mail() via the local MTA (this is
# what multiplayer-api does in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
