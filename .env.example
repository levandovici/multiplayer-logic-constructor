APP_DEBUG=false
BASE_URL=

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# HMAC pepper for token digests (player tokens, game private keys).
# Generate once per environment: php -r "echo bin2hex(random_bytes(32));"
TOKEN_PEPPER=

# Required when cron scripts are invoked over HTTP (Hostinger web cron).
CRON_TOKEN=

# Developer login-code mail — sent via mail(); set the From address.
EMAIL_FROM=
# If this host has no sendmail/mail() transport, point SMTP_* at a provider
# Authenticated SMTP sender (src/mailer.php) — better deliverability than mail().
# Hostinger: SMTP_HOST=smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS),
# SMTP_USER/SMTP_FROM = the mailbox created in hPanel > Emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
